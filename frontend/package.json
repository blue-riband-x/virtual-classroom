{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "serve": "node --max-http-header-size=32768 node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint"
    },
    "dependencies": {
        "@vueuse/core": "^14.3.0",
        "animate.css": "^4.1.1",
        "core-js": "^3.8.3",
        "echarts": "^6.0.0",
        "lucide-vue-next": "^1.0.0",
        "mockjs": "^1.1.0",
        "pinia": "^3.0.4",
        "three": "^0.156.1",
        "vue": "^3.2.13",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@babel/core": "^7.12.16",
        "@babel/eslint-parser": "^7.12.16",
        "@babel/plugin-transform-class-static-block": "^7.28.6",
        "@vue/cli-plugin-babel": "~5.0.0",
        "@vue/cli-plugin-eslint": "~5.0.0",
        "@vue/cli-service": "~5.0.0",
        "eslint": "^7.32.0",
        "eslint-plugin-vue": "^8.0.3"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/vue3-essential",
            "eslint:recommended"
        ],
        "parserOptions": {
            "parser": "@babel/eslint-parser"
        },
        "rules": {
            "no-unused-vars": "warn",
            "no-undef": "off",
            "vue/multi-word-component-names": "off"
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ]
}
