# 环境变量示例文件
# 复制此文件为 .env 并填入真实值

# ========== 应用配置 ==========
DEBUG=True
PROJECT_NAME=Virtual Classroom API
VERSION=1.0.0
API_V1_STR=/api/v1

HOST=0.0.0.0
PORT=8000

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 数据库配置 ==========
# MySQL (生产推荐)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/virtual_classroom

# SQLite (开发简便)
DATABASE_URL=sqlite+aiosqlite:///./virtual_classroom.db

# ========== 向量数据库配置 ==========
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=text-embedding-v4

# ========== CORS配置 ==========
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ========== 文件上传配置 ==========
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/gif"]

# ========== 阿里百炼（DashScope）配置 ==========
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v4

# ========== DeepSeek配置 ==========
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== 游戏化配置 ==========
XP_PER_MINUTE=10
XP_PER_CORRECT_ANSWER=50
STREAK_BONUS_MULTIPLIER=1.5
LEVEL_BASE_XP=100
LEVEL_XP_MULTIPLIER=1.5

# ========== SSE配置 ==========
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=3

# ========== 日志配置 ==========
LOG_LEVEL=INFO
